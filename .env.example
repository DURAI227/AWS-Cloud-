# Flask Application Configuration
FLASK_ENV=production
FLASK_DEBUG=0
PORT=5000
SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production

# AWS Cloud Settings
AWS_REGION=us-east-1
AWS_DEFAULT_REGION=us-east-1
S3_BUCKET_NAME=my-aws-deployment-backups-bucket
# Note: On EC2, IAM Roles (Instance Profiles) are preferred over static keys.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# CI/CD Jenkins Integration
JENKINS_URL=http://jenkins.example.com:8080
JENKINS_JOB_NAME=aws-cloud-deployment-pipeline

# GitHub Repository Metadata
GITHUB_REPO_URL=https://github.com/DURAI227/AWS-Cloud-.git
GIT_BRANCH=main

# Application Metadata
APP_NAME=AWS Cloud Deployment Dashboard
APP_VERSION=1.0.0

